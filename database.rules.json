{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid == $userId"
      }
    },

    "fcmTokens": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },

    "papers": {
      "$paperId": {
        ".read": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()",
        ".write": "auth != null && (!data.exists() || root.child('papersByUser').child(auth.uid).child($paperId).exists())"
      }
    },

    "papersByUser": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null"
      }
    },

    "tasks": {
      "$paperId": {
        ".read": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()",
        ".write": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()"
      }
    },

    "comments": {
      "$paperId": {
        ".read": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()",
        ".write": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()"
      }
    },

    "status_history": {
      "$paperId": {
        ".read": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()",
        ".write": "auth != null && root.child('papersByUser').child(auth.uid).child($paperId).exists()"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    },

    "userChats": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null"
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    },

    "notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null"
      }
    }
  }
}
